---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/manrope';
import serifLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import sansLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { site } from '../config/site';

interface Props { title?: string; description?: string; path?: string; noindex?: boolean; ogImage?: string }
const { title = site.title, description = site.description, path = '/', noindex = false, ogImage } = Astro.props;
const canonical = new URL(path, site.url).href;
const og = ogImage ? new URL(ogImage, site.url).href : undefined;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: `${site.name} – ${site.role.toLowerCase()}`,
  description: site.description,
  url: site.url,
  image: og,
  priceRange: '200 zł',
  address: { '@type': 'PostalAddress', streetAddress: site.street.replace('ul. ', ''), postalCode: site.postal, addressLocality: site.city, addressRegion: site.region, addressCountry: 'PL' },
  employee: { '@type': 'Person', name: site.name, jobTitle: site.role, alumniOf: 'Uniwersytet SWPS' },
  areaServed: ['Plewiska', 'Poznań', 'Komorniki', 'Luboń', 'Polska (online)'],
  ...(site.phone ? { telephone: site.phone } : {}),
  ...(site.email ? { email: site.email } : {}),
  sameAs: [site.bookingUrl],
};
---
<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title>
<meta name="description" content={description}/>
<link rel="canonical" href={canonical}/>
{noindex && <meta name="robots" content="noindex,follow"/>}
<meta name="theme-color" content="#F4EFE7"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin/>
<link rel="preconnect" href="https://images.unsplash.com"/>
<meta property="og:type" content="website"/>
<meta property="og:locale" content="pl_PL"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/>
{og && <meta property="og:image" content={og}/>}
<meta name="twitter:card" content="summary_large_image"/>
<script type="application/ld+json" set:html={JSON.stringify(ld)}/>
<script is:inline>
  // Ukrycie elementów hero od pierwszej klatki (animacje wejścia), tylko gdy ruch jest dozwolony.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
</script>
<slot name="head"/>
</head>
<body>
<a class="skip" href="#tresc">Przejdź do treści</a>
<slot/>
</body>
</html>
